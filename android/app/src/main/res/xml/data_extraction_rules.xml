<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) backup/transfer rules.

  Excludes the shared_preferences file that holds the Supabase session
  (refresh + access tokens, key "sb-wtncuzcskpigqpmnxwws-auth-token",
  written by supabase_flutter's default SharedPreferencesLocalStorage) from
  both cloud backup and device-to-device transfer. See docs/DECISIONS.md T-005.

  Android backup exclusion is file-granular, not key-granular: this file
  ("FlutterSharedPreferences", set by shared_preferences_android's
  LegacySharedPreferencesPlugin.SHARED_PREFERENCES_NAME) is also where
  theme/locale/onboarding/notification prefs live, so excluding it means
  those are not backed up either. That is the accepted trade-off per T-005
  (manifest-only fix, no migration to a per-key-capable storage backend).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
    </device-transfer>
</data-extraction-rules>
